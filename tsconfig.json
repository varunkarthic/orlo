{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "types": ["vite/client"]
  },
  "include": ["packages/*/src", "apps/docs/src"]
}
